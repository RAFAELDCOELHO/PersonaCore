# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Training / runtime outputs (memory lives in weights — never commit them)
checkpoints/
*.pt
logs/
data/

# Tooling caches
.pytest_cache/
.ruff_cache/
.gstack/

# Obsidian UI state never belongs in the source repository
.obsidian/

# Claude Code agent worktrees (isolation="worktree") — never commit these
.claude/worktrees/
