<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PHASE 32 (D-05) — the v5.0 sweep agent: `phase32_points.py run` runs all 12 advr points in the
  D-17 order (the n8 control, the n64 control, then the other 10), resuming point by point after a
  crash: every finished point's record is committed alone (D-11), so a relaunch skips it. A copy of
  com.personacore.phase31.probe.plist: the same caffeinate -dims wrapper, venv python, heartbeat
  file, working directory and environment; its own label and log pair. The developer copies it to
  ~/Library/LaunchAgents, then `launchctl bootstrap`, `launchctl kickstart`, and `launchctl bootout`
  once the run has finished.

  D-06: at the committed stop line the driver writes a `stop_line` heartbeat and exits 0.
  D-20: the argv is FIXED. A past-the-line relaunch is the documented manual command in
  32-RUNBOOK.md (`run with the past-stop-line flag and the ruling`), never an edit to this file.

  IT DOES NOT START ITSELF. RunAtLoad is false and KeepAlive is false: loading starts nothing; the
  run begins only on `launchctl kickstart` and ends for good when the driver exits.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personacore.phase32.sweep</string>

  <!-- KEEPALIVE IS FALSE FOR THE SAME REASON THE SWEEP'S IS (D-10): a crash must look like a
       stopped job that a human reads a stall record about, never a supervisor re-entering a point.
       The driver's resume is sha-pinned per sidecar, but the decision to relaunch is a person's. -->
  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <false/>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-dims</string>
    <string>/Users/juliorcoelho/PersonaCore/.venv/bin/python</string>
    <string>/Users/juliorcoelho/PersonaCore/scripts/phase32_points.py</string>
    <string>run</string>
    <string>--heartbeat</string>
    <string>/Users/juliorcoelho/PersonaCore/data/phase25_heartbeat.jsonl</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/juliorcoelho/PersonaCore</string>

  <key>StandardOutPath</key>
  <string>/Users/juliorcoelho/PersonaCore/logs/phase32_sweep.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/juliorcoelho/PersonaCore/logs/phase32_sweep.err</string>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- D-44: any pytest run during the scoring skips the MPS legs loudly instead of contending. -->
    <key>PERSONACORE_SWEEP_ACTIVE</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
