<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PHASE 42 (RECIPE-01..04, D-22) — the E3 recipe-search agent: `phase42_recipes.py run` runs the
  pending sigma = 0 controls (stage 1) and then, once the control records and
  scripts/phase42_threshold_prereg.py are tracked, the pending noised points (stage 2), in
  phase42_prereg.UNITS order, ONE v6.0 ledger attempt per unit under require_launch("E3"), beats on
  data/v6_mps_heartbeat.jsonl. A copy of com.personacore.phase41.e1.plist: the same
  caffeinate -dims wrapper (the child caffeinate holds the assertions), venv python, working
  directory and environment; its own log pair.
  Rafael copies it to ~/Library/LaunchAgents, then `launchctl bootstrap` and `launchctl kickstart`,
  only after his "approved" and a passing `phase42_recipes.py preflight`; `launchctl bootout` once
  the run has finished.

  IT DOES NOT START ITSELF. RunAtLoad is false and KeepAlive is false: loading starts nothing; the
  run begins only on `launchctl kickstart` and ends for good when the driver exits.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personacore.phase42.e3</string>

  <!-- KEEPALIVE IS FALSE: a crashed unit's re-run is a new attempt, allowed only after Rafael's
       "approved" and a root-cause note — never a supervisor's restart. -->
  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <false/>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-dims</string>
    <string>/Users/juliorcoelho/PersonaCore/.venv/bin/python</string>
    <string>/Users/juliorcoelho/PersonaCore/scripts/phase42_recipes.py</string>
    <string>run</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/juliorcoelho/PersonaCore</string>

  <key>StandardOutPath</key>
  <string>/Users/juliorcoelho/PersonaCore/logs/phase42_e3.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/juliorcoelho/PersonaCore/logs/phase42_e3.err</string>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- D-44: any pytest run during the E3 run skips the MPS legs loudly instead of contending. -->
    <key>PERSONACORE_SWEEP_ACTIVE</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
