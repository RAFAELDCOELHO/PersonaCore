<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PHASE 36 (D-16) — the v6.0 MPS cost-probe agent: `phase36_probe.py run` times every front in
  RUN_ORDER (e5, e6, e3, e2, e1) in ONE unattended agent run, writing the v6.0 ledger and beating
  data/v6_mps_heartbeat.jsonl. A copy of com.personacore.phase31.probe.plist: the same caffeinate
  -dims wrapper, venv python, working directory and environment; its own heartbeat and log pair.
  The developer copies it to ~/Library/LaunchAgents, then `launchctl bootstrap`, `launchctl
  kickstart`, and `launchctl bootout` once the run has finished.

  IT DOES NOT START ITSELF. RunAtLoad is false and KeepAlive is false: loading starts nothing; the
  run begins only on `launchctl kickstart` and ends for good when the driver exits.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.personacore.phase36.probe</string>

  <!-- KEEPALIVE IS FALSE FOR THE SAME REASON THE SWEEP'S IS (D-10): a crash must look like a
       stopped job that a human reads a stall record about, never a supervisor re-entering a point.
       The driver's resume is sha-pinned per sidecar, but the decision to relaunch is a person's. -->
  <key>KeepAlive</key>
  <false/>

  <key>RunAtLoad</key>
  <false/>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-dims</string>
    <string>/Users/juliorcoelho/PersonaCore/.venv/bin/python</string>
    <string>/Users/juliorcoelho/PersonaCore/scripts/phase36_probe.py</string>
    <string>run</string>
    <string>--heartbeat</string>
    <string>/Users/juliorcoelho/PersonaCore/data/v6_mps_heartbeat.jsonl</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/juliorcoelho/PersonaCore</string>

  <key>StandardOutPath</key>
  <string>/Users/juliorcoelho/PersonaCore/logs/phase36_probe.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/juliorcoelho/PersonaCore/logs/phase36_probe.err</string>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- D-44: any pytest run during the scoring skips the MPS legs loudly instead of contending. -->
    <key>PERSONACORE_SWEEP_ACTIVE</key>
    <string>1</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
